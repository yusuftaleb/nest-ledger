# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
# On Vercel these go under Settings → Environment Variables instead (Vercel's Supabase integration fills in the Supabase ones).

# Your Supabase project: Project Settings → API. The public key is the publishable key, or the anon key
# (NEXT_PUBLIC_SUPABASE_ANON_KEY) if that's what you have; either works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only, never shown in the browser. Used to create the owner's account on /setup and accounts from join links.
SUPABASE_SERVICE_ROLE_KEY=

# The password for claiming a brand-new copy at /setup. Used once.
SETUP_PASSWORD=

# Optional: lets each deploy update the database by itself (the session pooler string from Supabase → Connect).
# Without it, run `npx supabase db push` after updates.
POSTGRES_URL_NON_POOLING=

# How money and dates are written. One copy serves one household, so these are set once.
# Currency is an ISO code (CAD, USD, EUR, GBP…), locale a language and region (en-CA, en-US, fr-CA, de-DE…),
# and the week starts on Monday (1) or Sunday (0). Changing one needs a redeploy.
NEXT_PUBLIC_CURRENCY=CAD
NEXT_PUBLIC_LOCALE=en-CA
NEXT_PUBLIC_WEEK_START=1

# Optional: 1 when Supabase has your own email sender (Authentication → SMTP), to offer emailed sign-in codes.
NEXT_PUBLIC_EMAIL_CODES=
